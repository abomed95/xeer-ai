# ===== Xeer AI — configuration =====

# Clé OpenAI (obligatoire hors mode démo)
OPENAI_API_KEY=
# Modèle OpenAI réel (ex. gpt-4o-mini, gpt-4o). Doit exister côté OpenAI.
OPENAI_MODEL=gpt-4o-mini

# Sécurité — OBLIGATOIRE en production (l'API refuse de démarrer sinon).
# Génère-la avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
XEER_SECRET_KEY=change-me-in-production

# Base de données. Vide = fichier SQLite local (développement).
# En production, une URL PostgreSQL rend les données persistantes :
# DATABASE_URL=postgresql://user:password@host:25060/xeer?sslmode=require
DATABASE_URL=

# Compte administrateur initial
XEER_ADMIN_EMAIL=admin@xeer.ai
XEER_ADMIN_PASSWORD=

# Mode démo : 1 = réponses simulées sans RAG ni OpenAI (tests/démos)
XEER_DEMO_MODE=0

# ===== Paiements =====
# sandbox (défaut) = paiements simulés | live = vrais fournisseurs
XEER_PAYMENTS_MODE=sandbox

# WaafiPay (https://developer.waafipay.com)
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=

# CAC Bank (CAC Pay — identifiants marchands fournis par la banque)
CACBANK_API_URL=
CACBANK_MERCHANT_ID=
CACBANK_API_KEY=

# Cartes Visa / MasterCard (passerelle compatible Stripe)
CARD_GATEWAY_SECRET_KEY=

# ===== Signature des webhooks de paiement =====
# OBLIGATOIRE en mode live : sans secret, un callback non authentifié pourrait
# activer un abonnement sans paiement. Ces valeurs sont fournies par chaque
# fournisseur (« webhook signing secret »).
WAAFI_WEBHOOK_SECRET=
CACBANK_WEBHOOK_SECRET=
CARD_WEBHOOK_SECRET=

# ===== Limitation de débit =====
# 1 = active (défaut). Protège contre le bruteforce et l'abus de /ask.
XEER_RATE_LIMIT_ENABLED=1
